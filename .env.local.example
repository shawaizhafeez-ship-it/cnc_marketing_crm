# =============================================================================
# CNC Marketing CRM — Environment Variables
# Copy to .env.local and fill in values. Never commit .env.local
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (required)
# Dashboard → Project Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose to the browser (cron jobs, sheet sync, admin ops)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
ALLOWED_EMAIL_DOMAIN=cncservices.net

# Supabase Auth Hook secret — set on Edge Function only (see supabase/AUTH_SETUP.md)
# BEFORE_USER_CREATED_HOOK_SECRET=v1,whsec_...

# -----------------------------------------------------------------------------
# SMTP — Renewal emails (renewal@cncservices.net)
# Server-only
# -----------------------------------------------------------------------------
SMTP_RENEWAL_HOST=mail.cncservices.net
SMTP_RENEWAL_PORT=465
SMTP_RENEWAL_USER=renewal@cncservices.net
SMTP_RENEWAL_PASSWORD=

# -----------------------------------------------------------------------------
# SMTP — Marketing emails (info@cncservices.net)
# Server-only
# -----------------------------------------------------------------------------
SMTP_MARKETING_HOST=mail.cncservices.net
SMTP_MARKETING_PORT=465
SMTP_MARKETING_USER=info@cncservices.net
SMTP_MARKETING_PASSWORD=

# Optional SMTP overrides
# SMTP_TIMEOUT=30

# -----------------------------------------------------------------------------
# Google Sheets sync (server-only)
# Service account must have access to the spreadsheet
# -----------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Renewals
GOOGLE_WORKSHEET_NAME=List Cleaned

# -----------------------------------------------------------------------------
# Cron job authentication (server-only)
# Vercel Cron sends: Authorization: Bearer <CRON_SECRET>
# -----------------------------------------------------------------------------
CRON_SECRET=generate-a-long-random-string
